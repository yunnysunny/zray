#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
    [ "$(uci -q get zray.main.enabled)" = 1 ] || return 0
    [ "$(uci -q get zray.main.mode)" != direct ] || return 0
    procd_open_instance monitor
    procd_set_param command /usr/libexec/zray-ui-monitor
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
