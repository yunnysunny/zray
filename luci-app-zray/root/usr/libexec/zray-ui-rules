#!/bin/sh
set -eu
action="${1:-reload}"
if [ "$action" = stop ]; then
    result=0
    if tables="$(/usr/sbin/nft --json list tables)"; then
        if printf '%s' "$tables" | /usr/bin/jsonfilter -e '@.nftables[*].table.name' | /bin/grep -qx zray; then
            /usr/sbin/nft delete table inet zray || result=1
        fi
    else
        result=1
    fi
    if [ -f /tmp/dnsmasq.d/zray.conf ]; then
        /bin/rm /tmp/dnsmasq.d/zray.conf || result=1
        /etc/init.d/dnsmasq reload || result=1
    fi
    exit "$result"
fi
if [ "$action" != failed ]; then
    state="$(/bin/ubus call service list '{"name":"zray-ui"}')"
    running="$(printf '%s' "$state" | /usr/bin/jsonfilter -e '@["zray-ui"].instances.proxy.running')"
    if [ "$running" != true ]; then
        [ "$action" = reload ] && exec "$0" stop
        echo '代理进程尚未运行。' >&2
        exit 1
    fi
fi
exec /usr/bin/ucode /usr/share/zray-ui/policy.uc "$action"
