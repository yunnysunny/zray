import * as p from 'zray_policy';
let passed = 0;
function check(value, message) { assert(value, message); passed++; }
check(p.validate_options({}) == null, '默认配置');
check(p.validate_options({mode: 'invalid'}) != null, '拒绝未知模式');
check(p.validate_options({device_mode: 'selected'}) != null, '拒绝空设备列表');
check(p.validate_options({devices: ['aa:bb:cc:dd:ee:ff'], device_mode: 'selected'}) == null, 'MAC 地址');
check(p.validate_options({devices: ['x; reboot']}) != null, 'MAC 注入');
check(p.validate_options({direct_ip: ['192.0.2.1/33']}) != null, 'CIDR 长度');
check(p.validate_options({direct_ip: ['1.1.1.1/32']}) == null, 'IPv4 CIDR');
check(p.validate_options({proxy_domains: ['a.com; reboot']}) != null, '域名注入');
check(p.validate_options({direct_domains: ['a.com'], proxy_domains: ['a.com']}) != null, '冲突域名');
check(p.validate_options({health_interval: '0'}) != null, '检测频率下界');
check(p.validate_options({probe_url: "https://a.com/';reboot"}) != null, '探测 URL 注入');
check(p.validate_options({dns_url: 'http://a.com'}) != null, '拒绝明文 DNS URL');
const global = p.rules({}, ['1.1.1.1'], 'br-lan', false);
check(index(global, 'meta l4proto tcp counter redirect to :1080') >= 0, '全局 TCP 转发');
const direct = p.rules({mode: 'direct'}, ['1.1.1.1'], 'br-lan', false);
check(index(direct, 'redirect to') < 0, '直连无重定向');
const selected = p.rules({device_mode: 'selected', devices: ['aa:bb:cc:dd:ee:ff'], ipv6_policy: 'block'}, ['1.1.1.1'], 'br-lan', false);
check(index(selected, 'ether saddr { aa:bb:cc:dd:ee:ff }') >= 0, '限制设备');
check(index(selected, 'icmpv6 type admin-prohibited') >= 0, 'IPv6 阻断');
const block = p.rules({failure_policy: 'block'}, ['1.1.1.1'], 'br-lan', true);
check(index(block, 'redirect to') < 0 && index(block, 'counter reject with icmp type admin-prohibited') >= 0, '故障阻断');
const failDirect = p.rules({failure_policy: 'direct'}, ['1.1.1.1'], 'br-lan', true);
check(index(failDirect, 'reject') < 0, '故障直连');
const dns = p.dns_rules({direct_domains: ['example.com'], bootstrap_dns: '223.5.5.5'});
check(index(dns, 'nftset=/example.com/4#inet#zray#direct_domains4') >= 0, 'DNS nftset');
check(p.options({}).failure_policy == 'direct', '默认故障策略不得阻断上网');
check(index(p.rules({}, ['1.1.1.1'], 'br-lan', true), 'reject') < 0, '默认启动失败没有拒绝规则');
check(index(block, 'chain guard_output') < 0, '断网保护不得阻断路由器恢复流量');
check(index(p.rules({failure_policy: 'direct', ipv6_policy: 'block'}, ['1.1.1.1'], 'br-lan', true), 'reject') < 0, '故障直连同时解除 IPv6 阻断');
print({passed});
